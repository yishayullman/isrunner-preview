# Isrunner local server configuration
PORT=3000
HOST=127.0.0.1
DB_PATH=./data/isrunner.db

# Comma-separated list of allowed origins for write-operation Origin validation
# Leave empty to automatically allow the request's own Host origin (http://localhost:<PORT>, http://127.0.0.1:<PORT>)
ALLOWED_ORIGINS=

# Set to "true" only when running behind HTTPS in production
COOKIE_SECURE=false

# Garmin Connect Developer Program credentials (DO NOT commit real secrets)
# Leave empty until Garmin approves the developer application and issues keys.
# While empty, Garmin connection & ingestion remain honestly disabled.
GARMIN_CLIENT_ID=
GARMIN_CLIENT_SECRET=
GARMIN_WEBHOOK_SECRET=

# Strava API v3 credentials (free self-serve at https://www.strava.com/settings/api)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_WEBHOOK_VERIFY_TOKEN=

# Resend Email OTP verification (free 3,000 emails/month at https://resend.com)
# When set, new accounts receive a 6-digit verification code and only verified emails enter the global leaderboard.
RESEND_API_KEY=
EMAIL_FROM=Isrunner <onboarding@resend.dev>
